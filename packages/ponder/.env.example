# ═══════════════════════════════════════════════════════════════════
# packages/ponder/.env
# Scholarship Protocol v4 — Ponder Indexer Environment
# ═══════════════════════════════════════════════════════════════════
#
# Copy this file:  cp .env.example .env
# NEVER commit .env to version control.
#
# Run indexer:
#   Development → bun dev
#   Production  → bun start  (atau pakai PM2: pm2 start ecosystem.config.ts)
# ═══════════════════════════════════════════════════════════════════

# ════════════════════════════════════════════════════════════════════
# 1. BLOCKCHAIN — RPC & START BLOCK
# ════════════════════════════════════════════════════════════════════

# RPC endpoint untuk Lisk Sepolia (chain id: 4202)
# Pakai provider seperti Alchemy, Infura, QuickNode, atau public RPC:
# Public (rate-limited): https://rpc.sepolia-api.lisk.com
# Alchemy: https://lisk-sepolia.g.alchemy.com/v2/YOUR_KEY
PONDER_RPC_URL_LISK="https://rpc.sepolia-api.lisk.com"
CHAIN=""
# Block pertama setelah semua contract di-deploy.
# Dapatkan dari tx receipt deployment di blockscout.
# Ponder akan index semua event mulai dari block ini.
# Contoh: START_BLOCK=1234567
START_BLOCK=0

# ════════════════════════════════════════════════════════════════════
# 2. CONTRACT ADDRESSES (hasil deployment)
# ════════════════════════════════════════════════════════════════════
# Isi setelah kamu deploy pakai:
#   bun hardhat ignition deploy ignition/modules/scholarship-v4.ts --network liskSepolia
# Alamat tersimpan di packages/contract/ignition/deployments/

# Hub utama: program lifecycle, voting, milestone
CONTRACT_CORE="0x0000000000000000000000000000000000000000"

# Custodian dana: donasi, disburse, slash, yield
CONTRACT_TREASURY="0x0000000000000000000000000000000000000000"

# Watchdog: dispute & bounty hunter
CONTRACT_BOUNTY="0x0000000000000000000000000000000000000000"

# Soulbound reputation token untuk voter
CONTRACT_REPUTATION="0x0000000000000000000000000000000000000000"

# Scoring & dispute committee
CONTRACT_COMMITTEE="0x0000000000000000000000000000000000000000"

# ════════════════════════════════════════════════════════════════════
# 3. DATABASE — PostgreSQL
# ════════════════════════════════════════════════════════════════════
# Ponder menggunakan PostgreSQL via Drizzle ORM.
# Untuk local: install PostgreSQL atau pakai Docker:
#   docker run -d --name pgdb -e POSTGRES_PASSWORD=password -p 5432:5432 postgres

# Untuk koneksi individual (dipakai src/db/index.ts):
DB_HOST="localhost"
DB_PORT=5432
DB_USER="postgres"
DB_PASSWORD="password"
DB_NAME="scholarship_v4"

# SSL: set "true" untuk production (Supabase, Railway, Neon, dll)
DB_SSL="false"

# Untuk Drizzle Kit migrations (dipakai drizzle.config.ts):
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL="postgresql://postgres:password@localhost:5432/scholarship_v4"

# ════════════════════════════════════════════════════════════════════
# 4. IPFS
# ════════════════════════════════════════════════════════════════════
# Host IPFS node untuk upload dokumen (write operations).
# Gunakan node IPFS lokal atau Pinata/Infura IPFS.
#
# Local IPFS node (harus running):
#   docker run -d -p 5001:5001 -p 8080:8080 ipfs/kubo
IPFS_HOST="localhost"

# Gateway URL untuk fetch/read CID dari IPFS (dipakai src/utils/ipfs.ts).
# Bisa pakai gateway publik atau self-hosted.
# Contoh publik: https://ipfs.io, https://cloudflare-ipfs.com
# Contoh Pinata: https://gateway.pinata.cloud
# Contoh self-hosted cloudflare tunnel (seperti di code-mu sekarang):
IPFS_HOST_REQUEST="http://localhost:8080"
PINATA_JWT=""
PINATA_GATEWAY=""

# ════════════════════════════════════════════════════════════════════
# 5. GEMINI AI (opsional — untuk server health monitoring)
# ════════════════════════════════════════════════════════════════════
# Dipakai di gemini.service.ts untuk analisis health check log.
# Kalau tidak dipakai, bisa dikosongkan.
# Dapatkan API key di: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""
