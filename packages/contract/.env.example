# ═══════════════════════════════════════════════════════════════════
# packages/contract/.env
# Scholarship Protocol v4 — Contract / Deployment Environment
# ═══════════════════════════════════════════════════════════════════
#
# Copy this file:  cp .env.example .env
# NEVER commit .env to version control.
#
# Deploy commands:
#   Local  → bun hardhat ignition deploy ignition/modules/scholarship-v4.ts --network localhost
#   Testnet→ bun hardhat ignition deploy ignition/modules/scholarship-v4.ts --network liskSepolia --verify
# ═══════════════════════════════════════════════════════════════════

# ── Deployer Wallet ──────────────────────────────────────────────────
# Private key wallet yang deploy semua contract.
# Format: 0x + 64 hex characters
# ⚠️  Pakai dedicated deployer wallet, BUKAN wallet utama kamu
# Contoh (Hardhat default account #0, aman untuk local saja):
# DEPLOYER_PRIVATE_KEY="0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80"
DEPLOYER_PRIVATE_KEY=""

# ── USDC Token Address ───────────────────────────────────────────────
# Address USDC yang dipakai program untuk donasi dan disbursement.
# Kalau KOSONG → deployment script otomatis deploy MockUSDC (local/testnet only).
# Kalau DIISI  → pakai USDC existing di network tersebut.
# Lisk Sepolia testnet: cek https://sepolia-blockscout.lisk.com
USDC_ADDRESS=""

# ── Protocol Fee Recipient ───────────────────────────────────────────
# Wallet penerima protocol fee (10% dari setiap slash event).
# Kalau KOSONG → otomatis pakai deployer wallet.
# Untuk production: gunakan multisig (Gnosis Safe, dll)
PROTOCOL_FEE_RECIPIENT=""

# ── Ganache Mnemonic (local testing only) ────────────────────────────
# Hanya dipakai kalau network = ganache.
# Default Hardhat/Ganache mnemonic (aman untuk lokal, tidak sensitif):
MNEMONIC="test test test test test test test test test test test junk"
